{
  "name": "projexar",
  "compatibility_date": "2026-07-30",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    // The Worker reaches the static files through env.ASSETS, which only
    // exists once the binding is named.
    "binding": "ASSETS",
    // Serve public/404.html instead of a bare 404 for unknown paths. The
    // footer links to /trust, which is not built yet.
    "not_found_handling": "404-page",
    // Assets are matched before the Worker runs, and not_found_handling would
    // otherwise be free to answer an unmatched path itself. Pinning /api/*
    // ahead of the asset layer keeps the contact endpoint reachable whatever
    // the asset router decides.
    "run_worker_first": ["/api/*"]
  },
  // Restricted to the one address, so a bug in the Worker cannot turn the
  // binding into an open relay.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "mark@douc.tech"
    }
  ]
}
